{
  "expo": {
    "name": "RockPaperSnap",
    "slug": "RockPaperSnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rockpapersnap",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.viharaz87.RockPaperSnap",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/appIcon.jpg",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8f22ee5e-9341-46ec-86b8-d27e200518be"
      }
    }
  }
}
